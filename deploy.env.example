# Copy to deploy.env (ignored by git) and fill in your NAS. scripts/deploy.sh reads it.
LMSCACHE_HOST=nas                                    # ssh alias or hostname of the NAS
LMSCACHE_REMOTE_DIR=/volume1/models/lmscache/src     # where the source is copied on the NAS
LMSCACHE_SHARE=/volume1/models                       # the SMB-shared folder that holds the library
LMSCACHE_CONFIG=/volume1/models/lmscache/config      # settings and database, keep chmod 700
LMSCACHE_UID=1000                                    # owner of the share on the NAS
LMSCACHE_GID=10
LMSCACHE_PORT=8080
